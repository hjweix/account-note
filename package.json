{
  "name": "accountnote",
  "version": "1.2.0",
  "description": "Account Note是一个浏览器扩展插件，用于增强账号管理体验。它允许用户为不同网站的账号添加备注信息，帮助用户更好地管理和识别不同的账户。",
  "main": "webpack.config.js",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "watch": "webpack --watch --config webpack.config.js",
    "check:css": "node scripts/check-css-scope.js",
    "check:css:dupes": "node scripts/check-css-scope.js --dupes",
    "check:i18n": "node scripts/check-i18n.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.2",
    "terser-webpack-plugin": "^5.3.11",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  }
}
